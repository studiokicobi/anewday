{
  "name": "anewday",
  "version": "2.0.0",
  "private": true,
  "description": "A New Day – privacy-first daily checklist that resets at local midnight.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && playwright test tests/e2e",
    "test:a11y": "npm run build && playwright test tests/a11y",
    "build:analyze": "vite build && vite-bundle-visualizer --open false",
    "check:budgets": "npm run build && npm run lhci",
    "lhci": "node ./scripts/lighthouse.js",
    "lighthouse": "npm run build && node ./scripts/lighthouse.js",
    "lint": "eslint \"src/**/*.{ts,svelte}\" \"tests/**/*.ts\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "postinstall": "node ./scripts/install-playwright.cjs",
    "audit:dependencies": "node ./scripts/audit-dependencies.js"
  },
  "dependencies": {
    "@tailwindplus/elements": "^1.0.14",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/svelte": "^5.0.2",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": "^22.23.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "tmp": "^0.2.5",
    "qs": "^6.14.1",
    "lodash": "^4.18.0",
    "lodash-es": "^4.18.0",
    "serialize-javascript": "^7.0.5",
    "path-to-regexp": "^0.1.13",
    "uuid": "^14.0.0",
    "yaml": "^1.10.3",
    "axios": "^1.18.1",
    "js-yaml": "^3.15.1",
    "fast-uri": "^3.1.7",
    "body-parser": "^1.20.6",
    "ws@7": "^7.5.11",
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@5": {
      "brace-expansion": "^2.1.4"
    },
    "minimatch@9": {
      "brace-expansion": "^2.1.4"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.9"
    }
  }
}
