{
  "name": "anewday",
  "version": "2.0.0",
  "private": true,
  "description": "A New Day – privacy-first daily checklist that resets at local midnight.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && playwright test tests/e2e",
    "test:a11y": "npm run build && playwright test tests/a11y",
    "build:analyze": "vite build && vite-bundle-visualizer --open false",
    "check:budgets": "npm run build && lhci autorun --config=.lighthouserc.json",
    "lhci": "lhci autorun",
    "lighthouse": "npm run build && (npm run preview & echo $! > .preview.pid) && wait-on http://localhost:4173 && npx lighthouse http://localhost:4173 --view --chrome-flags='--headless=new' --output=json --output=html --output-path=./.lighthouse; kill $(cat .preview.pid 2>/dev/null) 2>/dev/null || true; rm -f .preview.pid",
    "lint": "eslint \"src/**/*.{ts,svelte}\" \"tests/**/*.ts\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "postinstall": "node ./scripts/install-playwright.cjs"
  },
  "dependencies": {
    "@tailwindplus/elements": "^1.0.14",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.44.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.2",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^3.0.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^17.3.0",
    "jsdom": "^27.0.0",
    "lighthouse": "^12.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "svelte-check": "^4.3.2",
    "svelte-eslint-parser": "^1.0.0",
    "tailwindcss": "^3.4.3",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vite": "^7.0.0",
    "vite-bundle-visualizer": "^0.6.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.0",
    "wait-on": "^7.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tmp": "^0.2.5",
    "qs": "^6.14.1",
    "lodash": "^4.17.23",
    "lodash-es": "^4.18.1",
    "serialize-javascript": "^7.0.3"
  }
}
